# Copie ce fichier en ".env" et remplis tes valeurs. Le .env n'est JAMAIS commité.

# --- 4escape ---
FE_BASE=https://braincaen.4escape.io
FE_USER=ton-identifiant-4escape
FE_PASS=ton-mot-de-passe-4escape
# Optionnel : forcer l'URL de la liste Devis si la détection échoue
# QUOTES_PATH=/admin/statistics/quotes

# --- Supabase (pour la vraie synchro, PAS pour la sonde) ---
# La clé service_role se trouve dans Supabase → Project Settings → API.
# Elle contourne la RLS : elle ne doit vivre QUE côté robot, jamais dans le CRM public.
SUPABASE_URL=https://zclivocuvsdzinvhtpmj.supabase.co
SUPABASE_SERVICE_KEY=ta-cle-service-role
